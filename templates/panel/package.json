{
  "name": "uptime",
  "displayName": "运行时间（模板）",
  "description": "最小的面板插件模板：资源页上一张卡片，读 uptime 显示这台机器开了多久、负载还剩多少，带一个按钮动作。没有依赖。",
  "version": "1.0.0",
  "contributes": {
    "panels": [
      {
        "id": "uptime",
        "title": "运行时间",
        "command": "node \"$CODA_PLUGIN_PATH/scripts/panel.mjs\"",
        "maxAge": "PT1M",
        "actions": {
          "mark": {
            "command": "node \"$CODA_PLUGIN_PATH/scripts/mark.mjs\"",
            "confirm": "记下此刻？\n面板之后显示距这次记下过了多久。"
          }
        }
      }
    ]
  }
}
