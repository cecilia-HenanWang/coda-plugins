{
  "name": "@coda-console/opencode",
  "id": "opencode",
  "displayName": "OpenCode",
  "description": "OpenCode Agent：Coda 的入口在运行机的 opencode acp 与 Coda 之间转发，并把会话指令放进原生会话的第一轮。",
  "version": "1.2.3",
  "contributes": {
    "agents": [
      {
        "id": "opencode",
        "displayName": "OpenCode",
        "icon": {
          "light": "icons/opencode-light.pdf",
          "dark": "icons/opencode-dark.pdf"
        },
        "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/agent/entry.mjs\"",
        "modes": {
          "title": "工作模式",
          "unset": "Agent 默认",
          "note": "工具权限沿用运行机的 OpenCode 配置。"
        },
        "skillsDir": ".agents/skills",
        "configFiles": [
          "${OPENCODE_CONFIG}",
          "${XDG_CONFIG_HOME:-~/.config}/opencode/opencode.json",
          "${XDG_CONFIG_HOME:-~/.config}/opencode/opencode.jsonc",
          "${XDG_CONFIG_HOME:-~/.config}/opencode/config.json",
          "opencode.json",
          "opencode.jsonc"
        ],
        "setupHint": "请在运行机安装并登录 OpenCode，确认后端能执行 opencode acp。"
      }
    ],
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "opencode.modelProvider": {
          "type": "string",
          "format": "coda-model-provider",
          "title": "模型服务",
          "order": 1,
          "description": "选一个插件提供的模型服务（如 Magpie），它列出的模型和 OpenCode 自己的模型一起出现在会话的模型里；选中它的模型，那个会话就走这个服务。支持 OpenAI Chat、OpenAI Responses 和 Anthropic 接口。"
        }
      }
    },
    "setup": {
      "command": "exec \"$CODA_NODE\" \"$CODA_PLUGIN_PATH/scripts/setup.mjs\""
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-plugins.git",
    "directory": "plugins/opencode"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "agent",
    "scripts",
    "icons"
  ],
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
